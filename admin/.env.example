# Base URL of the backend API the admin panel talks to.
#
# Local development (default if unset): http://localhost:4001/api/v1
VITE_API_BASE_URL=http://localhost:4001/api/v1

# IMPORTANT — production builds:
# The admin is hosted separately from the API, so a production build MUST set
# this to the PUBLIC backend URL, otherwise it falls back to localhost and the
# whole panel (including login) fails for real users. Create `admin/.env.production`
# (or set the var in your host/CI) with, e.g.:
#   VITE_API_BASE_URL=https://api.yourdomain.com/api/v1
# then rebuild (`npm run build`) and redeploy.
