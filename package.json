    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "mysql2": "^3.24.4",
    "razorpay": "^2.9.4",
    "slugify": "^1.6.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.15",
    "eslint": "^9.9.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
