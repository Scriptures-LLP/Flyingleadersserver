PORT=4001
NODE_ENV=development

# Dedicated database name on the shared Atlas cluster — never point this at
# an existing database (bidready / newleeybackups / sample_mflix) that also
# lives on that cluster.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.y0huyrb.mongodb.net/flying_leader_dev?retryWrites=true&w=majority

JWT_SECRET=change-me-to-a-long-random-string
JWT_CUSTOMER_EXPIRES_IN=30d
JWT_ADMIN_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

UPLOAD_ROOT=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4001/uploads

# Comma-separated list of allowed origins (admin panel dev server, Expo web, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

SEED_ADMIN_EMAIL=admin@flyingleader.com
SEED_ADMIN_PASSWORD=change-me-please

# MySQL sync (module E) — see README-mysql-dev.md. Off by default.
MYSQL_SYNC_ENABLED=false
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
FLYINGDOTCOM_STORAGE_ROOT=

# Module D — Firebase Phone Auth service account, base64-encoded JSON.
FIREBASE_SERVICE_ACCOUNT_B64=

# Module K — AI chatbot (OpenAI).
LLM_API_KEY=

# SMTP — sends password-reset emails. For Gmail / Google Workspace use
# smtp.gmail.com:587 with an *app password* (not the account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# MSG91 SMS OTP (Flow API v5) — sends the login / password-reset codes by SMS.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# The exact, case-sensitive name of the OTP placeholder in the template
# (the ##...## in the template text, e.g. OTP or var1).
MSG91_OTP_VAR=
# Optional: fictional numbers that accept a fixed code with NO SMS sent, for
# testing — "number:code" pairs, comma-separated. Use numbers that cannot exist
# (Indian mobiles start 6-9), e.g. +911234567890:123456
OTP_TEST_NUMBERS=
